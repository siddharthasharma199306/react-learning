      "seed": 1364414952,
      "version": 346,
      "versionNonce": 1643589571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787594372845,
      "link": null,
      "locked": false,
      "text": "Creating more presentational/dumb components allow for a more robust\nproduct as dumb components, also referred to as \"Pure\" components\nare easier to test. They can be deterministic same input will always produce\nsame output.\n",
      "fontSize": 19.39066641194061,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creating more presentational/dumb components allow for a more robust\nproduct as dumb components, also referred to as \"Pure\" components\nare easier to test. They can be deterministic same input will always produce\nsame output.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
