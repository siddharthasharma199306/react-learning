      "updated": 1787589520202,
      "link": null,
      "locked": false,
      "text": "React is declarative in nature:\n\"Given this state, this is what UI should look like\"\nRather than the imperative nature which says\n\"Find this DOM, change the text, add this class etc\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "tamUR0ias0ZVmYthP3KeZ",
      "originalText": "React is declarative in nature:\n\"Given this state, this is what UI should look like\"\nRather than the imperative nature which says\n\"Find this DOM, change the text, add this class etc\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
