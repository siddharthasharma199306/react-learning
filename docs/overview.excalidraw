      "versionNonce": 137419160,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589274742,
      "link": null,
      "locked": false,
      "text": "Component is a reusable unit of UI +\nbehavior",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "xF8rzzPrRPnOzXlTy9t41",
      "originalText": "Component is a reusable unit of UI + behavior",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YIf8xm_dldECxhKLM635z",
      "type": "text",
      "x": 166.5557237440475,
      "y": -438.01610280652073,
      "width": 539,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 1809807336,
      "version": 621,
      "versionNonce": 849697768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589312769,
      "link": null,
      "locked": false,
      "text": "Component is any reusable unit of UI and\ncan include behaviour as well.\nIt can be as small as a Button or as large\nas an entire page\n\nWhenever state changes, any component that\nsubscribes to that change, rerenders.\n\nReact does not re-create the entire DOM when\nstate changes it compares the updated output with\nprevious HTML DOM and only updates the section\nof DOM that needs updating",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Component is any reusable unit of UI and\ncan include behaviour as well.\nIt can be as small as a Button or as large\nas an entire page\n\nWhenever state changes, any component that\nsubscribes to that change, rerenders.\n\nReact does not re-create the entire DOM when\nstate changes it compares the updated output with\nprevious HTML DOM and only updates the section\nof DOM that needs updating",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TIuXJBRzHSzcDvC--Pifk",
