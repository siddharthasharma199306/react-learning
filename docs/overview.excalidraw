    {
      "id": "HI0rTk6wL4HnMan4Ol346",
      "type": "text",
      "x": 226.6937191749193,
      "y": -948.7443732079973,
      "width": 431.1998291015625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 493399016,
      "version": 111,
      "versionNonce": 973254040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589266484,
      "link": null,
      "locked": false,
      "text": "React is a function of state\n\nUI = f(state)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "VgbLGke77vh7f8mY8sg_H",
      "originalText": "React is a function of state\n\nUI = f(state)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "O7c87P_zKWa9ldJ35V7DT",
      "type": "text",
      "x": 180.25351851939405,
      "y": -806.2431553182792,
      "width": 429.4453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1044049640,
      "version": 564,
      "versionNonce": 361334760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589276648,
      "link": null,
      "locked": false,
      "text": "State is the data that is dynamic in\nnature and every update to which should\nshow up on the UI.\n\nInternal variables that should not\ntrigger re-render should not be created\nas a state\n\n//Insert live example",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "State is the data that is dynamic in nature and every update to which should show up on the UI.\n\nInternal variables that should not trigger re-render should not be created as a state\n\n//Insert live example",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "xF8rzzPrRPnOzXlTy9t41",
      "type": "rectangle",
