      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589283038,
      "link": null,
      "locked": false,
      "text": "React follows one-way data flow",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "TIuXJBRzHSzcDvC--Pifk",
      "originalText": "React follows one-way data flow",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BbNCCUV2r1amSLufAoi82",
      "type": "text",
      "x": 157.6434294203496,
      "y": 2.345826281577388,
      "width": 558.0658324524316,
      "height": 95.74405043827682,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2131009768,
      "version": 489,
      "versionNonce": 1891191192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787589383464,
      "link": null,
      "locked": false,
      "text": "In react the data flows from top of the DOM/component\ntree to bottom.There is no way for data to go from\nchildren to parent or from sibling to sibling\n",
      "fontSize": 19.148810087655377,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In react the data flows from top of the DOM/component\ntree to bottom.There is no way for data to go from\nchildren to parent or from sibling to sibling\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
