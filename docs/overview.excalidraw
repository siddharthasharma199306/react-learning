    {
      "id": "uTVgHqO_fDGU15k_EEwtM",
      "type": "text",
      "x": 110.27354371241461,
      "y": 1921.9496305159614,
      "width": 719.218682405804,
      "height": 121.19166507462879,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
