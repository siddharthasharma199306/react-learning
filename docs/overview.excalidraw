      "updated": 1787594372845,
      "link": null,
      "locked": false,
      "text": "How to divide a UI into\ncomponents?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "J-7ggkkaYxWAUNIPFF8XE",
      "originalText": "How to divide a UI into components?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YpLyb7LIC28yrTOSoc1Is",
      "type": "text",
      "x": 124.66728433861203,
      "y": 1057.769044034175,
      "width": 564.5996704101562,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 218202088,
      "version": 307,
      "versionNonce": 391001219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787594372845,
      "link": null,
      "locked": false,
      "text": "There is no set structure that needs\nto be followed, there are certain guidelines one can follow\nto allow for better component creation and scalable\nUI.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is no set structure that needs\nto be followed, there are certain guidelines one can follow\nto allow for better component creation and scalable\nUI.",
      "autoResize": true,
      "lineHeight": 1.25
    },
